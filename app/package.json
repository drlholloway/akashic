		"@vite-pwa/sveltekit": "^1.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.2",
		"vite-plugin-pwa": "^2.0.0",
		"wrangler": "^4.147.0"
	},
	"dependencies": {
		"minisearch": "^7.2.0"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		},
		"sharp": "0.35.5"
