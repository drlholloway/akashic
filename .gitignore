# Python
__pycache__/
*.pyc
.venv/
scraper/.venv/
*.egg-info/

# Scraped raw material (vendor HTML, PDFs, images) is never committed
data/raw/
data/cache/
# Closed vendors' documentation is kept in git so it outlives the store
!data/archive/
data/library.sqlite
data/library.sqlite-*

# Node
node_modules/
app/.svelte-kit/
app/build/
app/dev-dist/

# Generated data bundle (rebuilt by `pcblib export`)
app/static/data/

.DS_Store
.env

# Local data dumps, never committed
transistor-dump/
data/transistors.sqlite*

# Swift build output (Package.swift builds the Vision OCR helper)
.build/
.swiftpm/
