<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Weekly Akashic refresh (scripts/refresh.sh), Sundays at 04:00. If the Mac is asleep then, launchd
     runs it at the next wake. Install:   scripts/install-refresh.sh
     Remove:  launchctl bootout gui/$(id -u)/com.cryptideffects.akashic-refresh -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.cryptideffects.akashic-refresh</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>__ROOT__/scripts/refresh.sh</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>__ROOT__/data/cache/refresh/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>__ROOT__/data/cache/refresh/launchd.log</string>
</dict>
</plist>
